APP_NAME="MadFan"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

# Force HTTPS URL generation (recommended behind cPanel SSL)
FORCE_HTTPS=true

# Admin subdomain (Filament + Inertia ops console). Host only, no https://
# Create ops.your-domain.com in cPanel → Domains (same docroot as main site).
ADMIN_DOMAIN=ops.your-domain.com
# Optional overrides (default to ADMIN_DOMAIN):
# FILAMENT_DOMAIN=mod.your-domain.com
# ADMIN_APP_DOMAIN=mod.your-domain.com
# FILAMENT_PATH=admin
# With ADMIN_DOMAIN set, Inertia mounts at https://mod.your-domain.com/ (root).
# Only set this if you still want the legacy /app prefix on the admin host:
# ADMIN_APP_PATH=app

# CORS: list exact origins for browser/mobile clients (comma-separated). Avoid * in production.
CORS_ALLOWED_ORIGINS=https://your-domain.com
CORS_SUPPORTS_CREDENTIALS=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# MySQL from cPanel → MySQL® Databases
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_dbname
DB_USERNAME=cpaneluser_dbuser
DB_PASSWORD=

# Shared hosting defaults (no Redis required)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
# Default disk is private (task proof screenshots). Fan avatars use the public disk explicitly.
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.your-domain.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Social integrations
SOCIAL_ALLOW_MOCK_VERIFICATION=false
# TWITTER_CLIENT_ID=
# TWITTER_CLIENT_SECRET=
# TWITTER_BEARER_TOKEN=
# TWITTER_REDIRECT_URI="${APP_URL}/auth/twitter/callback"
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=
# DISCORD_REDIRECT_URI="${APP_URL}/auth/discord/callback"
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=

# One account per person / device (registration hardening)
REGISTRATION_ENFORCE_ONE_ACCOUNT=true
REGISTRATION_REQUIRE_FINGERPRINT=true
REGISTRATION_UNIQUE_FINGERPRINT=true
# Keep false on shared hosting / CGNAT — true blocks everyone after first signup from same IP
REGISTRATION_UNIQUE_IP=false
# Only used when REGISTRATION_UNIQUE_IP=true
REGISTRATION_IP_LOOKBACK_HOURS=24

VITE_APP_NAME="${APP_NAME}"

# Filament admin (seeded by FilamentAdminSeeder)
FILAMENT_ADMIN_NAME="Mad Fan Admin"
FILAMENT_ADMIN_EMAIL=admin@your-domain.com
FILAMENT_ADMIN_PASSWORD=ChangeMe123!
FILAMENT_ADMIN_ROLE=super-admin

# One-shot web migrator — delete cpanel-migrate.php after use
DEPLOY_MIGRATE_SECRET=

# Do not delete between deploys (breaks API tokens):
# storage/app/paseto_symmetric.key
