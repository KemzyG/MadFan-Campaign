APP_NAME=MadFan
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

# Set true behind HTTPS / reverse proxy / cPanel
FORCE_HTTPS=true

# Admin subdomain for Filament + Inertia /app (host only). Leave empty locally.
ADMIN_DOMAIN=
# FILAMENT_DOMAIN=
# ADMIN_APP_DOMAIN=
# FILAMENT_PATH=admin
# ADMIN_APP_PATH=app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=database/database.sqlite
# DB_USERNAME=root
# DB_PASSWORD=

# MySQL (optional local/production):
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=madfan
# DB_USERNAME=
# DB_PASSWORD=

# Prefer redis in production for sessions/cache/queues under load
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.your-domain.com
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=madfan-local
REVERB_APP_KEY=madfan-reverb-key
REVERB_APP_SECRET=madfan-reverb-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Run the WebSocket server locally:
#   php artisan reverb:start
# Production: prefer a process supervisor (or Laravel Cloud / Forge daemon) for `reverb:start`.
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=madfan_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# CORS (browser clients hitting /api/*). Comma-separate production origins; avoid * with credentials.
CORS_ALLOWED_ORIGINS=https://your-domain.com
CORS_SUPPORTS_CREDENTIALS=false

# Disable Boost browser log POSTs in production
BOOST_BROWSER_LOGS_WATCHER=false

# Filament / Inertia admin seeder (change before first seed)
FILAMENT_ADMIN_NAME="Mad Fan Admin"
FILAMENT_ADMIN_EMAIL=admin@your-domain.com
FILAMENT_ADMIN_PASSWORD=
FILAMENT_ADMIN_ROLE=super-admin

# Social OAuth / verification
SOCIAL_ALLOW_MOCK_VERIFICATION=true
PASETO_TTL_MINUTES=1440
ADMIN_MFA_REQUIRED=true

# Require verified email for dashboard/API/social. Set false for local/dev without mail.
EMAIL_VERIFICATION_ENABLED=true
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_BEARER_TOKEN=
TWITTER_TARGET_USERNAME=madfan
# TWITTER_REDIRECT_URI=https://your-domain.com/auth/twitter/callback

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# DISCORD_REDIRECT_URI=https://your-domain.com/auth/discord/callback

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_USERNAME=@madfan
TELEGRAM_BOT_USERNAME=

# One-shot web migrator (delete public/cpanel-migrate.php after use)
DEPLOY_MIGRATE_SECRET=

